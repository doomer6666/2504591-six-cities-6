  "guests": 6,
  "price": 300,
  "features": ["Breakfast", "Washer"],
  "coordinates": [48.85661, 2.351499]
}

###

## Получить предложениt
GET http://localhost:4000/offers/69e0be2e8681d09d801a5765 HTTP/1.1
Content-Type: application/json

###

## Изменить предложение
PATCH  http://localhost:4000/offers/69de6dbca6ee245ff3c0364a HTTP/1.1
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJlbWFpbCI6InRvcmFuc0BvdmVybG9vay5uZXQiLCJuYW1lIjoiSmVmcmV5IEVwc3RpbmUiLCJpZCI6IjY5ZGE2MTE0ODM5YjkwZTc3NGI4ZDZmMCIsImlhdCI6MTc4MDE0Mjk3MywiZXhwIjoxNzgwMzE1NzczfQ.zZRuiHH_koEGd9E6399es1aXH45uFrOBXsp5bXLEQCc


{
  "name": "Не оочень уютный домик на остове"
}
###

## Удалить предложение
DELETE  http://localhost:4000/offers/69de6dbca6ee245ff3c0364a HTTP/1.1
Content-Type: application/json

###

## Добавить оффер в избранное
