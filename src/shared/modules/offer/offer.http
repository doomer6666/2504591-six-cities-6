# Предложения
## Получить список предложений
GET http://localhost:4000/offers HTTP/1.1
Content-Type: application/json

###

## Получить список предложений, будучи авторизованным
GET http://localhost:4000/offers HTTP/1.1
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJlbWFpbCI6InRvcmFuc0BvdmVybG9vay5uZXQiLCJuYW1lIjoiSmVmcmV5IEVwc3RpbmUiLCJpZCI6IjY5ZGE2MTE0ODM5YjkwZTc3NGI4ZDZmMCIsImlhdCI6MTc4MDE0Mjk3MywiZXhwIjoxNzgwMzE1NzczfQ.zZRuiHH_koEGd9E6399es1aXH45uFrOBXsp5bXLEQCc
###

## Добавить новое предложение
POST http://localhost:4000/offers HTTP/1.1
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJlbWFpbCI6InRvcmFuc0BvdmVybG9vay5uZXQiLCJuYW1lIjoiSmVmcmV5IEVwc3RpbmUiLCJpZCI6IjY5ZGE2MTE0ODM5YjkwZTc3NGI4ZDZmMCIsImlhdCI6MTc4MDE0Mjk3MywiZXhwIjoxNzgwMzE1NzczfQ.zZRuiHH_koEGd9E6399es1aXH45uFrOBXsp5bXLEQCc

{
  "name": "Уютный домик на острове1",
  "description": "УютноУютноУютноУютноУютноУютно",
  "city": "Paris",
  "preview": "none",
  "isPremium": true,
  "rating": 5,
  "type": "Apartment",
